+
+    # During head-only adaptation, requires_grad=False prevents gradient
+    # updates but does not stop BatchNorm statistics, Dropout, or DropPath
+    # behavior from changing. Keep the complete frozen backbone in eval mode
+    # and explicitly return only the classifier head to training mode.
+    if args is not None and getattr(args, "trainable_modules", "all") == "fc":
+        model_for_mode = model.module if hasattr(model, "module") else model
+
+        for module_name, module in model_for_mode.named_modules():
+            is_classifier = (
+                module_name == "fc" or module_name.startswith("fc.")
+            )
+            if module_name and not is_classifier:
+                module.eval()
+
+        model_for_mode.fc.train(True)
+
+        unexpected_training_modules = [
+            module_name
+            for module_name, module in model_for_mode.named_modules()
+            if module_name
+            and not (module_name == "fc" or module_name.startswith("fc."))
+            and module.training
+        ]
+        if unexpected_training_modules:
+            raise RuntimeError(
+                "Frozen backbone modules remained in training mode: "
+                + ", ".join(unexpected_training_modules[:10])
+            )
+
+        print("Head-only mode: frozen backbone is in eval mode; fc is in train mode")
+
     metric_logger = utils.MetricLogger(delimiter="  ")
